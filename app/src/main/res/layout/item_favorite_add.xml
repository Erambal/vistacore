<?xml version="1.0" encoding="utf-8"?>
<!--
    Trailing "＋ Add more" square in the favourites grid. Keeps the populated grid from
    being a dead end: there is no Live TV button in the top row (by design), so this is
    how the user reaches the live list to favourite more channels.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="12dp"
    android:padding="10dp"
    android:background="@drawable/card_selector"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false">

    <com.vistacore.launcher.ui.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="＋"
            android:textSize="72sp"
            android:textColor="@color/accent_gold"
            android:fontFamily="sans-serif-light" />
    </com.vistacore.launcher.ui.SquareFrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/home_favorites_browse_live"
        android:textSize="19sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
